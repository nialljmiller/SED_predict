[paths]
data_file = data/yso_training_data.csv

[general]
test_size = 0.2
val_size = 0.2
random_state = 69
output_dir = outputs/
model_type = xgboost
hyperparameter_tuning = False
search_n_jobs = 1
booster_n_jobs = 1

[columns]
feature_columns = GAL_LAT, GAL_LONG, GAL_LONG_sin, GAL_LONG_cos, Ks_mag, I1_mag, I2_mag, I3_mag, I4_mag, alpha, Ks_I1, I1_I2, I2_I3, I3_I4, I4_mag_sq
target_column = Mips_24_mag

[xgboost]
learning_rate = 0.01
n_estimators = 2000
max_depth = 6
min_child_weight = 1
subsample = 1.0
colsample_bytree = 1.0
reg_alpha = 0.1
reg_lambda = 1.0
n_jobs = 1

[ngboost]
learning_rate = 0.1
n_estimators = 100
max_depth = 3

[mlp]
learning_rate = 0.1
n_estimators = 100
max_depth = 3
